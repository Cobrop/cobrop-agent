{
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "NODEJS_HELPERS": "0"
  },
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/**"
    }
  },
  "crons": [
    {
      "path": "/agent/cron/tick?max=5",
      "schedule": "0 6 * * *"
    }
  ]
}
