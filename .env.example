# ── CoBrop Agent · .env ───────────────────────────────────────────
# Copy to .env and fill in. All services here have free tiers — no
# credit card required for Groq, Gemini, Supabase, Vercel, GitHub.

# ── Server ────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# ── LLM · Groq (primary, free) ────────────────────────────────────
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── LLM · Google Gemini (fallback, free 1.5k req/day) ─────────────
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Database · Supabase (free 500MB) ──────────────────────────────
# Create a project: https://supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL (for raw psql + schema push)
DATABASE_URL=postgres://postgres:[password]@db.[project].supabase.co:5432/postgres

# ── Auth secrets ──────────────────────────────────────────────────
# Long random strings — generate with: openssl rand -hex 32
WEBHOOK_SECRET=
CRON_SECRET=
ADMIN_JWT_SECRET=

# ── Social media (optional · all free dev tiers) ──────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=urn:li:organization:0000000

FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

INSTAGRAM_BUSINESS_ID=

# ── WhatsApp Business (free 1k conv/mo) ──────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Cloudflare Workers AI (free 10k req/day, optional) ────────────
# Used for image perceptual hashing in fraud detection
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Agent runtime ─────────────────────────────────────────────────
# How often the queue worker polls for new tasks (ms)
QUEUE_POLL_MS=5000

# Concurrent tasks per worker
QUEUE_CONCURRENCY=3

# Public URL of this service (used in webhook URLs sent to brokers)
PUBLIC_URL=http://localhost:8787
